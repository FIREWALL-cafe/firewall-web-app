{
  "name": "firewall-web-app",
  "version": "0.1.0",
  "description": "The Firewall Pop-Up client on the web.",
  "homepage": "/",
  "main": "index.js",
  "engines": {
    "node": "20.x.x"
  },
  "scripts": {
    "predeploy": "yarn run format && yarn run lint && yarn run build",
    "deploy": "node scripts/deploy.js",
    "rollback": "node scripts/rollback.js",
    "build": "react-scripts build",
    "start:server": "NODE_ENV=development nodemon index.js --watch index.js --watch server/",
    "start:client": "BROWSER=none NODE_NO_WARNINGS=1 react-scripts start",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "test:minimal": "react-scripts test --watchAll=false --testPathPattern=minimal",
    "eject": "react-scripts eject",
    "dev": "NODE_ENV=development concurrently \"yarn run start:server\" \"yarn run start:client\" --kill-others",
    "start": "NODE_ENV=production node index.js",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\""
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.8.2",
    "chart.js": "^4.4.8",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "customize-cra": "^1.0.0",
    "d3-scale": "^4.0.2",
    "express": "^4.18.2",
    "node-fetch": "^2.6.1",
    "postmark": "3.11.0",
    "querystring": "^0.2.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-modern-drawer": "^1.4.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^6.27.0",
    "react-scripts": "^5.0.1",
    "react-simple-maps": "^3.0.0",
    "react-tooltip": "^5.28.0",
    "serpapi": "^2.1.0",
    "typed.js": "^2.1.0",
    "yet-another-react-lightbox": "^3.21.8"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "autoprefixer": "^10.4.19",
    "aws-sdk": "^2.1692.0",
    "cli-progress": "^3.12.0",
    "concurrently": "^8.2.2",
    "gh-pages": "^5.0.0",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.3"
  },
  "proxy": "http://localhost:8080",
  "repository": {
    "url": "https://github.com/FIREWALL-cafe/firewall-web-app"
  },
  "license": "MIT",
  "keywords": [
    "node",
    "express"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
