{
  "name": "firewall-web-app",
  "version": "0.1.0",
  "description": "The Firewall Pop-Up client on the web.",
  "homepage": "/",
  "engines": {
    "node": "20.x.x"
  },
  "scripts": {
    "predeploy": "yarn run format && yarn run lint && yarn run build",
    "deploy": "node scripts/deploy.js",
    "rollback": "node scripts/rollback.js",
    "build": "react-scripts build",
    "dev": "react-scripts start",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "test:minimal": "react-scripts test --watchAll=false --testPathPattern=minimal",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\""
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@sanity/client": "^7.12.0",
    "@sanity/image-url": "^1.2.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "chart.js": "^4.4.8",
    "d3-scale": "^4.0.2",
    "querystring": "^0.2.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-modern-drawer": "^1.4.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^6.27.0",
    "react-scripts": "^5.0.1",
    "react-simple-maps": "^3.0.0",
    "react-tooltip": "^5.28.0",
    "serpapi": "^2.1.0",
    "typed.js": "^2.1.0",
    "undici": "^7.16.0",
    "yet-another-react-lightbox": "^3.21.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^5.0.0",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.3"
  },
  "repository": {
    "url": "https://github.com/FIREWALL-cafe/firewall-web-app"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "vercel",
    "censorship"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
